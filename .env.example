# Database URL (Neon PostgreSQL or Local SQLite)
# Example for Neon Cloud: postgresql://username:password@ep-host.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///storage/db/nexus.db

# Optional AI Model API Keys (If omitted, NEXUS runs on its built-in offline engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
